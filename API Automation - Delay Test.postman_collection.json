					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 404) {\r",
							"    pm.test(\"404 Not Found - Endpoint does not exist\", function () {\r",
							"        pm.expect(pm.response.code).to.eql(404);\r",
							"    });\r",
							"}\r",
							""
